<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffecd2;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#fcb69f;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="400" height="300" fill="url(#bg5)"/>
  
  <!-- Testing pyramid -->
  <polygon points="200,60 120,180 280,180" fill="#ff6b6b" stroke="#fff" stroke-width="2" opacity="0.8"/>
  <polygon points="200,100 140,180 260,180" fill="#4ecdc4" stroke="#fff" stroke-width="2" opacity="0.8"/>
  <polygon points="200,140 160,180 240,180" fill="#45b7d1" stroke="#fff" stroke-width="2" opacity="0.8"/>
  
  <!-- Test levels -->
  <text x="200" y="75" text-anchor="middle" fill="white" font-size="12" font-weight="bold" font-family="Arial">E2E</text>
  <text x="200" y="115" text-anchor="middle" fill="white" font-size="12" font-weight="bold" font-family="Arial">Integration</text>
  <text x="200" y="155" text-anchor="middle" fill="white" font-size="12" font-weight="bold" font-family="Arial">Unit Tests</text>
  
  <!-- Test automation icons -->
  <circle cx="80" cy="220" r="15" fill="#6c5ce7" stroke="#fff" stroke-width="2"/>
  <text x="80" y="226" text-anchor="middle" fill="white" font-size="14" font-family="Arial">🤖</text>
  
  <circle cx="150" cy="220" r="15" fill="#00d2d3" stroke="#fff" stroke-width="2"/>
  <text x="150" y="226" text-anchor="middle" fill="white" font-size="14" font-family="Arial">⚡</text>
  
  <circle cx="220" cy="220" r="15" fill="#ff9ff3" stroke="#fff" stroke-width="2"/>
  <text x="220" y="226" text-anchor="middle" fill="white" font-size="14" font-family="Arial">📊</text>
  
  <circle cx="290" cy="220" r="15" fill="#54a0ff" stroke="#fff" stroke-width="2"/>
  <text x="290" y="226" text-anchor="middle" fill="white" font-size="14" font-family="Arial">✅</text>
  
  <!-- Automation pipeline -->
  <rect x="50" y="250" width="300" height="8" rx="4" fill="#333" opacity="0.3"/>
  <rect x="50" y="250" width="200" height="8" rx="4" fill="#00d2d3"/>
  
  <!-- Pipeline steps -->
  <circle cx="70" cy="254" r="4" fill="#fff"/>
  <circle cx="120" cy="254" r="4" fill="#fff"/>
  <circle cx="170" cy="254" r="4" fill="#fff"/>
  <circle cx="220" cy="254" r="4" fill="#fff"/>
  <circle cx="270" cy="254" r="4" fill="#fff" opacity="0.5"/>
  
  <!-- Coverage indicators -->
  <text x="320" y="80" text-anchor="start" fill="#333" font-size="12" font-family="Arial">Coverage:</text>
  <rect x="320" y="90" width="60" height="8" rx="4" fill="#ddd"/>
  <rect x="320" y="90" width="48" height="8" rx="4" fill="#00d2d3"/>
  <text x="320" y="110" text-anchor="start" fill="#333" font-size="10" font-family="Arial">80%</text>
  
  <!-- Test status -->
  <text x="50" y="40" text-anchor="start" fill="#333" font-size="14" font-weight="bold" font-family="Arial">Tests: 247 ✅ | 3 ❌ | 12 ⏸️</text>
  
  <!-- Title -->
  <text x="200" y="25" text-anchor="middle" fill="#333" font-size="22" font-weight="bold" font-family="Arial">E2E Testing Strategy</text>
</svg>