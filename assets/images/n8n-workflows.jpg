<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="nodeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ff6b6b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ee5a24;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="400" height="300" fill="url(#bg1)"/>
  
  <!-- Workflow nodes -->
  <circle cx="80" cy="80" r="25" fill="url(#nodeGrad)" stroke="#fff" stroke-width="2"/>
  <circle cx="200" cy="80" r="25" fill="url(#nodeGrad)" stroke="#fff" stroke-width="2"/>
  <circle cx="320" cy="80" r="25" fill="url(#nodeGrad)" stroke="#fff" stroke-width="2"/>
  
  <circle cx="140" cy="160" r="25" fill="url(#nodeGrad)" stroke="#fff" stroke-width="2"/>
  <circle cx="260" cy="160" r="25" fill="url(#nodeGrad)" stroke="#fff" stroke-width="2"/>
  
  <circle cx="200" cy="240" r="25" fill="url(#nodeGrad)" stroke="#fff" stroke-width="2"/>
  
  <!-- Connection lines -->
  <line x1="105" y1="80" x2="175" y2="80" stroke="#fff" stroke-width="3" opacity="0.8"/>
  <line x1="225" y1="80" x2="295" y2="80" stroke="#fff" stroke-width="3" opacity="0.8"/>
  <line x1="95" y1="95" x2="125" y2="145" stroke="#fff" stroke-width="3" opacity="0.8"/>
  <line x1="215" y1="95" x2="245" y2="145" stroke="#fff" stroke-width="3" opacity="0.8"/>
  <line x1="165" y1="160" x2="175" y2="160" stroke="#fff" stroke-width="3" opacity="0.8"/>
  <line x1="155" y1="175" x2="185" y2="225" stroke="#fff" stroke-width="3" opacity="0.8"/>
  <line x1="245" y1="175" x2="215" y2="225" stroke="#fff" stroke-width="3" opacity="0.8"/>
  
  <!-- Icons in nodes -->
  <text x="80" y="85" text-anchor="middle" fill="white" font-size="16" font-family="Arial">⚡</text>
  <text x="200" y="85" text-anchor="middle" fill="white" font-size="16" font-family="Arial">🔄</text>
  <text x="320" y="85" text-anchor="middle" fill="white" font-size="16" font-family="Arial">📊</text>
  <text x="140" y="165" text-anchor="middle" fill="white" font-size="16" font-family="Arial">🛠️</text>
  <text x="260" y="165" text-anchor="middle" fill="white" font-size="16" font-family="Arial">📡</text>
  <text x="200" y="245" text-anchor="middle" fill="white" font-size="16" font-family="Arial">✅</text>
  
  <!-- Title -->
  <text x="200" y="35" text-anchor="middle" fill="white" font-size="24" font-weight="bold" font-family="Arial">n8n Automation</text>
</svg>